{
  "name": "mplads-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "data-gen"
  ],
  "scripts": {
    "start": "node --experimental-strip-types backend/src/server.ts",
    "build": "echo 'Backend ready for deployment'",
    "build:frontend": "npm run build -w frontend",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "generate": "npm run generate -w data-gen",
    "test": "npm test -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend && npm run typecheck -w data-gen"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
