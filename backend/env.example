# DRISHTI backend configuration — copy to backend/.env and fill in.
#
# Named `env.example` rather than `.env.example` on purpose: `.gitignore:18` matches
# `**/.env.*`, so a file called `.env.example` is invisible to git and every clone was
# missing the template `db.ts` told operators to copy. This name is tracked.
#
# `backend/.env` itself is gitignored and has never been committed (verified with
# `git log --all`). Nothing in this file is a real credential.

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Project URL and the service-role key, from the Supabase dashboard.
#
# NOTE, and it is load-bearing: the service-role key bypasses every RLS policy in
# `supabase/full_schema.sql`. Combined with the fact that no endpoint authenticates
# (see docs/API_CONTRACT.md §11), this is why generated SQL is fenced by both an
# application allowlist and a read-only database transaction. Do not deploy this
# publicly as-is.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Gemini (optional — enables POST /api/query) ─────────────────────────────
# Without this, `GET /api/query/status` reports `available: false` with a reason and the
# Ask-the-Corpus screen renders a disabled state. It does not fall back to a canned
# answer: a fabricated result is worse than an absent one.
#
# Google has moved the Gemini API to **auth keys** — credentials bound to a Google Cloud
# service account. Keys created in AI Studio are auth keys automatically. Unrestricted
# standard keys are already rejected, and all standard keys are rejected from September
# 2026, so a key that predates the migration will start failing with 401 rather than
# degrading. They are still API keys, not OAuth tokens: sent in the `x-goog-api-key`
# header. If you see `Expected OAuth 2 access token`, that message is misleading — the
# fix is a fresh auth key from https://aistudio.google.com/apikey, not an OAuth flow.
#
# `GOOGLE_API_KEY` is accepted as an alias and takes precedence, matching the Google
# SDKs' own resolution order.
GEMINI_API_KEY=

# Model override. The default is `gemini-3-flash-preview`. Google's Flash line moves
# faster than this repository will, so neither candidate name is hardcoded as gospel —
# set this if the default is retired. Nothing in DRISHTI's behaviour depends on which.
# GEMINI_MODEL=gemini-3-flash-preview

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# Names the actor `demo-officer` when no `x-user-id` header is supplied. This is not
# authentication and there is none — see docs/API_CONTRACT.md §11.
DEMO_MODE=true
